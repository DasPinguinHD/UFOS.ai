<Window x:Class="UFOS.ai.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UFOS.ai" Height="900" Width="1440" MinHeight="480" MinWidth="640"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="8" Padding="0" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Titlebar (existing chrome, unchanged) ===================== -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" CornerRadius="8,8,0,0" Height="18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="UFOS.ai" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource TertiaryForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentAmberBrush}" BorderBrush="Transparent">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentRedBrush}" BorderBrush="Transparent">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Main content ===================== -->
            <Grid Grid.Row="1" Margin="28,22,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===================== Header row ===================== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <Grid HorizontalAlignment="Left">
                            <TextBlock x:Name="HeadingText" Text="UFOS.ai" FontFamily="Consolas" FontSize="33" FontWeight="SemiBold"
                                       Foreground="{StaticResource HighEmphasisForegroundBrush}" />

                            <!-- UFO overlay: flying sprite + monochrome "landed" icon. Both are positioned
                                 and animated in code-behind once HeadingText has been measured, mirroring
                                 the reference design's JS (see MainWindow.xaml.cs / SetupUfoFlight). -->
                            <Canvas x:Name="UfoOverlayCanvas" ClipToBounds="False" IsHitTestVisible="False">

                                <!-- Flying saucer: flat, 2-color, matches the mockup's #ufoSprite -->
                                <Canvas x:Name="UfoFlightGroup" Width="1" Height="1" Opacity="1" RenderTransformOrigin="0,0">
                                    <Canvas x:Name="UfoSpriteInner" Width="100" Height="70" RenderTransformOrigin="0,0">
                                        <Canvas.RenderTransform>
                                            <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                                        </Canvas.RenderTransform>
                                        <Ellipse Canvas.Left="21" Canvas.Top="42" Width="58" Height="14" Fill="{StaticResource MutedForegroundBrush}" Opacity="0.5" />
                                        <Ellipse Canvas.Left="17" Canvas.Top="33" Width="66" Height="20" Fill="{StaticResource SecondaryForegroundBrush}" Stroke="#FF111111" StrokeThickness="1" />
                                        <Ellipse Canvas.Left="29" Canvas.Top="35" Width="42" Height="8" Fill="White" Opacity="0.3" />
                                        <Path Data="M34 33 C34 19 66 19 66 33 Z" Fill="{StaticResource AccentBlueBrush}" Opacity="0.85" Stroke="#FF111111" StrokeThickness="1" />
                                        <Ellipse Canvas.Left="25.6" Canvas.Top="41.6" Width="4.8" Height="4.8" Fill="{StaticResource AccentBlueBrush}" />
                                        <Ellipse Canvas.Left="38.6" Canvas.Top="47.6" Width="4.8" Height="4.8" Fill="{StaticResource AccentBlueBrush}" />
                                        <Ellipse Canvas.Left="56.6" Canvas.Top="47.6" Width="4.8" Height="4.8" Fill="{StaticResource AccentBlueBrush}" />
                                        <Ellipse Canvas.Left="69.6" Canvas.Top="41.6" Width="4.8" Height="4.8" Fill="{StaticResource AccentBlueBrush}" />
                                    </Canvas>
                                    <Canvas.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.45" Color="Black" />
                                    </Canvas.Effect>
                                </Canvas>

                                <!-- Landed, monochrome, superscript-sized UFO icon (parked behind ".ai") -->
                                <Canvas x:Name="UfoLandedGroup" Width="21" Height="12.6" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="UfoLandedScale" ScaleX="0.21" ScaleY="0.21" />
                                            <RotateTransform x:Name="UfoLandedRotate" Angle="0" CenterX="50" CenterY="30" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Canvas Width="100" Height="60">
                                        <Ellipse Canvas.Left="20" Canvas.Top="30" Width="60" Height="16" Fill="Transparent"
                                                 Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="3" />
                                        <Path Data="M35 30 C35 16 65 16 65 30" Fill="Transparent"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Canvas>
                            </Canvas>
                        </Grid>
                        <TextBlock Text="Module control center" Margin="0,4,0,0" FontSize="14" Foreground="{StaticResource SecondaryForegroundBrush}" />
                        <TextBlock x:Name="ClockText" Margin="0,4,0,0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Top">
                        <Button x:Name="SettingsButton" Width="38" Height="38" Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                MouseEnter="SettingsHoverArea_MouseEnter" MouseLeave="SettingsHoverArea_MouseLeave" Click="SettingsButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource MediumCornerRadius}">
                                        <TextBlock Text="&#9881;" FontSize="16" Foreground="{StaticResource SecondaryForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="{StaticResource SubtleHoverOpacity}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                               HorizontalOffset="-242" VerticalOffset="8" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource LargeCornerRadius}" Width="280" Padding="16"
                                    MouseEnter="SettingsHoverArea_MouseEnter" MouseLeave="SettingsHoverArea_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Auto-refresh feeds" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                                        <TextBlock Text="On" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Refresh interval" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                                        <TextBlock Text="30s" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Module directory" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                                        <TextBlock Text="UFOS.ai\" Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Desktop notifications" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                                        <TextBlock Text="Off" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Open logs on start" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" />
                                        <TextBlock Text="Off" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Show UFO mascot" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowUfoCheckBox" IsChecked="True" HorizontalAlignment="Right"
                                                  Checked="ShowUfoCheckBox_Changed" Unchecked="ShowUfoCheckBox_Changed" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Show verse of the day" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowVerseCheckBox" IsChecked="True" HorizontalAlignment="Right"
                                                  Checked="ShowVerseCheckBox_Changed" Unchecked="ShowVerseCheckBox_Changed" />
                                    </Grid>

                                    <!-- Opt-out of the startup AI notice. Only affects the startup dialog - the
                                         "✦ AI-GENERATED" labels on AI output (EU AI Act Art. 50) always stay.
                                         Comes back automatically when the notice text changes (NoticeVersion). -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Show AI notice at startup" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" VerticalAlignment="Center"
                                                   ToolTip="AI-generated content stays labelled either way. The notice can always be re-read via the link below." />
                                        <CheckBox x:Name="ShowAiNoticeCheckBox" IsChecked="True" HorizontalAlignment="Right"
                                                  Checked="ShowAiNoticeCheckBox_Changed" Unchecked="ShowAiNoticeCheckBox_Changed" />
                                    </Grid>

                                    <!-- Re-open the startup AI / "not investment advice" notice (EU AI Act Art. 50). -->
                                    <TextBlock x:Name="AiNoticeLink" Text="✦ AI content &amp; disclaimer notice" FontSize="12" Cursor="Hand"
                                               Foreground="{StaticResource AiAccentBrush}" Margin="0,0,0,12"
                                               ToolTip="Show the notice on AI-generated content and financial data again"
                                               MouseLeftButtonDown="AiNoticeLink_MouseLeftButtonDown" />

                                    <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <Grid>
                                            <TextBlock Text="UFOS.ai" Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" FontFamily="Consolas" />
                                            <TextBlock Text="build 2026.09" Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Proof-of-concept portfolio project — not a published product" FontSize="9.5" FontStyle="Italic"
                                               Foreground="{StaticResource QuietForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" Text="OVERVIEW" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,10" />

                <!-- ===================== Overview bar (5 equal cards) ===================== -->
                <!-- UniformGrid, same layout mechanism as the module grid below (Columns +
                     per-item trailing margin, no dedicated gap columns) - when Verse of the
                     Day is removed from Children and Columns drops to 4, the remaining 4
                     cards divide the row exactly the way the module grid divides its own
                     row into 4 columns, so the two rows line up. -->
                <UniformGrid x:Name="OverviewGrid" Grid.Row="3" Columns="5">

                    <!-- Markets -->
                    <Button Click="MarketsCard_Click" Cursor="Hand" Padding="14,12" Margin="0,0,14,0"
                            Template="{StaticResource OverviewCardButtonTemplate}" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MARKETS" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="MarketsHeadlineText" Text="S&amp;P 500 steady into the close" FontSize="16.5" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                            <TextBlock x:Name="MarketsSourceText" Text="Reuters · 6m ago" FontSize="10.5" Foreground="{StaticResource QuietForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Finance (featured) -->
                    <Button Focusable="False" Padding="14,12" Margin="0,0,14,0"
                            Template="{StaticResource OverviewCardButtonTemplate}" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBlueDimBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="FINANCE" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="FinanceValueText" Text="+$1,204.37" FontSize="22" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PositiveGreenBrush}" />
                            <TextBlock x:Name="FinanceChangeText" Text="+0.9% today · AAPL, XLF" FontSize="10.5" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Money Flows -->
                    <Button Click="MoneyFlowsCard_Click" Cursor="Hand" Padding="14,12" Margin="0,0,14,0"
                            Template="{StaticResource OverviewCardButtonTemplate}" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MONEY FLOWS" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="MoneyFlowsHeadlineText" Text="Tech inflows accelerate" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                            <TextBlock x:Name="MoneyFlowsSourceText" Text="Bloomberg · 22m ago" FontSize="10.5" Foreground="{StaticResource QuietForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Verse of the Day -->
                    <Button x:Name="VerseCard" Focusable="False" Padding="14,12" Margin="0,0,14,0"
                            Template="{StaticResource OverviewCardButtonTemplate}" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="VERSE OF THE DAY" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="VerseReferenceText" Text="Proverbs 21:5" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="VerseQuoteText" Text="&quot;The plans of the diligent lead to profit.&quot;" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryForegroundBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Portfolio Insight -->
                    <Button Focusable="False" Padding="14,12" Margin="0,0,14,0"
                            Template="{StaticResource OverviewCardButtonTemplate}" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PORTFOLIO INSIGHT" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="PortfolioInsightHeadlineText" Text="Diversification improved 4%" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                            <TextBlock x:Name="PortfolioInsightDetailText" Text="Illustrative sample · no portfolio connected yet" FontSize="10.5" Foreground="{StaticResource QuietForegroundBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Grid.Row="5" Text="MODULES" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,0,10" />

                <!-- ===================== Module grid (4 columns x 2 rows = 8 cells: 7 tiles + "Add module") ===================== -->
                <Grid Grid.Row="6">
                    <UniformGrid x:Name="ModuleGrid" Columns="4" Rows="2">
                        <UniformGrid.Resources>
                            <Thickness x:Key="TileMargin">0,0,14,14</Thickness>
                        </UniformGrid.Resources>

                        <!-- Hedge Fund -->
                        <Button x:Name="HedgeFundTile" Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenHedgeFund_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Hedge Fund" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource PositiveGreenBrush}" />
                                        </Grid>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v0.3.0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- LiveStream Agent -->
                        <Button x:Name="LiveStreamAgentTile" Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenLiveStreamAgent_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="LiveStream Agent" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource PositiveGreenBrush}" />
                                        </Grid>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v1.2.4" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Sentiment Optimization (not built yet -> illustrative only) -->
                        <Button Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenSentimentOptimization_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Sentiment Optimization" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource MutedForegroundBrush}" />
                                        </Grid>
                                        <TextBlock Text="Idle" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v0.1.0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Trading Strategy Discovery (not built yet -> illustrative only) -->
                        <Button Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenTradingStrategyDiscovery_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Strategy Discovery" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource MutedForegroundBrush}" />
                                        </Grid>
                                        <TextBlock Text="Idle" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v0.1.0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- System Logs -->
                        <Button x:Name="SystemLogsTile" Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenLogs_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="System Logs" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource PositiveGreenBrush}" />
                                        </Grid>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v1.0.1" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Transaction Log (AI request costs across all modules) -->
                        <Button x:Name="TransactionLogTile" Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenTransactionLog_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Transaction Log" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource PositiveGreenBrush}" />
                                        </Grid>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v0.1.0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Global Monitoring -->
                        <Button x:Name="GlobalMonitoringTile" Margin="0,0,14,14" Template="{StaticResource ModuleTileButtonTemplate}"
                                Background="{StaticResource ModuleTileBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1" Padding="16" Click="OpenGlobalMonitoring_Click">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SecondaryForegroundBrush}" Opacity="0.5" CornerRadius="2" Margin="-16,-16,-16,0" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <TextBlock Text="Global Monitoring" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid Width="6" Height="6" Margin="0,0,6,0">
                                            <Ellipse Fill="{StaticResource PositiveGreenBrush}" />
                                        </Grid>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                        <TextBlock Text=" · v0.1.0" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Add module (dashed, dimmed at rest) -->
                        <Button x:Name="AddModuleButton" Margin="0,0,14,14" Padding="16" Click="AddModule_Click"
                                Background="Transparent" Opacity="0.5"
                                MouseEnter="AddModuleButton_MouseEnter" MouseLeave="AddModuleButton_MouseLeave">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlBorderBrush}"
                                            BorderThickness="1.5" CornerRadius="{StaticResource LargeCornerRadius}" SnapsToDevicePixels="True">
                                        <Border.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="UseLayoutRounding" Value="True" />
                                            </Style>
                                        </Border.Resources>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryForegroundBrush}" />
                                <TextBlock Text="Add module" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource SecondaryForegroundBrush}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Illustrative launch caption toast -->
                    <Border x:Name="LaunchCaption" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0"
                            Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource PillCornerRadius}" Padding="14,8" Margin="0,0,0,10" IsHitTestVisible="False">
                        <TextBlock x:Name="LaunchCaptionText" Foreground="{StaticResource PrimaryForegroundBrush}" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
