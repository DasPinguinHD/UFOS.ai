# NOTE: part of UFOS.ai, a proof-of-concept portfolio project (not a published product).
# SEC EDGAR (insider trades) and FRED (macro indicators) moved to the Hedge Fund
# module's Financial Newsroom on 2026-09-24 — their settings now live in
# HedgeFund/backend/.env (see HedgeFund/backend/.env.example).

# --- World news RSS feeds (geopolitics/conflict layer) --- no key needed
# Replaced GDELT on 2026-09-24 (GDELT's IP rate limit made it unusable).
# Feed list: news_feeds.py.
NEWS_POLL_SECONDS=600
NEWS_MAX_AGE_HOURS=48

# --- GDACS (disasters) --- no key needed
GDACS_POLL_SECONDS=600
# Alerts whose end date (<gdacs:todate>) is more than this many hours in the
# past are dropped — GDACS keeps listing finished events for days.
GDACS_MAX_HOURS_SINCE_END=48

# --- OpenSky (notable flights) --- works anonymously; these are optional for a
# higher rate limit (OpenSky migrated to OAuth2 client-credentials in 2025).
# Register at https://opensky-network.org/
OPENSKY_POLL_SECONDS=240
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Pre-filter: drop a matching callsign below this altitude (local training/
# approach/departure, not a notable flight). Raise it to show fewer flights,
# lower it to show more.
OPENSKY_MIN_NOTABLE_ALTITUDE_METERS=1500

# --- Yahoo (market quotes) --- no key needed
YAHOO_POLL_SECONDS=90

# --- AI Assessment button (OpenRouter) ---
# Powers the "Assess"/"Sentiment" button on a marker. Same key style as the
# root app's UFOS.ai/.env.example ("Summarize with AI" button) — get one at
# https://openrouter.ai/keys. Optional: without it, the button just reports
# that no key is configured instead of crashing anything.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# --- Local news lookup (Google News search RSS, used by /localnews) --- no key needed
LOCALNEWS_MAX_RECORDS=8
LOCALNEWS_CACHE_SECONDS=1800
LOCALNEWS_ERROR_CACHE_SECONDS=45

# --- Networking ---
WS_HOST=0.0.0.0
WS_PORT=8767
HEALTH_PORT=8768
