<Window x:Class="UFOS.ai.GlobalMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Global Monitoring" Height="900" Width="1440" MinHeight="480" MinWidth="640"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF141414" />
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FF000000" />
        <SolidColorBrush x:Key="HighEmphasisForegroundBrush" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="#FFBFBFBF" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF49A7FF" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFEDB400" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="#FFED6A5A" />
        <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="999" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="8" Padding="0" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" CornerRadius="8,8,0,0" Height="18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Global Monitoring" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource TertiaryForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentAmberBrush}" BorderBrush="Transparent">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentRedBrush}" BorderBrush="Transparent">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Border Background="#FF0F0F0F" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <wv2:WebView2 x:Name="GlobeView" Visibility="Collapsed" />
                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading Global Monitoring…" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TertiaryForegroundBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
