<Window x:Class="UFOS.ai.ArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Article" Width="820" Height="680" MinWidth="480" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Titlebar (matches MainWindow's chrome) ===================== -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" CornerRadius="8,8,0,0" Height="18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Article" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource TertiaryForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentRedBrush}" BorderBrush="Transparent">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ArticleTitleText" Grid.Row="0" Text="Headline" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryForegroundBrush}" />
                <TextBlock x:Name="ArticleMetaText" Grid.Row="1" Text="Source · time" FontSize="11"
                           Foreground="{StaticResource QuietForegroundBrush}" Margin="0,6,0,12" />

                <!-- The real article, rendered by an embedded Chromium (WebView2) so
                     MarketWatch's bot-challenge sees a real browser, same as it would
                     in the user's own browser - a plain HTTP GET gets a CAPTCHA wall
                     instead of the page. -->
                <Grid Grid.Row="2">
                    <Border BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource MediumCornerRadius}" ClipToBounds="True">
                        <wv2:WebView2 x:Name="ArticleWebView" />
                    </Border>

                    <Border x:Name="LoadingOverlay" Background="{StaticResource ModulePanelBackgroundBrush}" CornerRadius="{StaticResource MediumCornerRadius}">
                        <TextBlock Text="Loading article…" FontSize="12" Foreground="{StaticResource QuietForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Shows either the source's own RSS teaser / a status message (plain), or
                         an AI summary. AI summaries get the violet AI container, the
                         "✦ AI-GENERATED · model · time" badge before the text and the caveat
                         after it (EU AI Act Art. 50 - see Shared/AiContent.cs). -->
                    <Border x:Name="SummaryPanel" Background="{StaticResource ModulePanelBackgroundBrush}" CornerRadius="{StaticResource MediumCornerRadius}" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <TextBlock x:Name="SummaryAiBadge" Visibility="Collapsed" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource AiAccentBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                           Foreground="{StaticResource SecondaryForegroundBrush}" />
                                <TextBlock x:Name="SummaryAiCaveat" Visibility="Collapsed" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedForegroundBrush}" Margin="0,10,0,0" />
                                <!-- What OpenRouter charged for this summary (usage.cost); also
                                     recorded in the shared AI cost ledger (Transaction Log). -->
                                <TextBlock x:Name="SummaryCostText" Visibility="Collapsed" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{StaticResource QuietForegroundBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                    <Button x:Name="SummarizeButton" Content="✦ Summarize with AI" Click="SummarizeButton_Click"
                            Template="{StaticResource RoundedDarkButtonTemplate}" Padding="12,7"
                            Background="{StaticResource AiSurfaceBrush}" BorderBrush="{StaticResource AiAccentBrush}" BorderThickness="1"
                            Foreground="{StaticResource AiAccentBrush}" FontSize="12" Margin="0,0,14,0" />
                    <TextBlock x:Name="OpenLinkText" Text="Open full article ↗" FontSize="12" Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OpenLinkText_MouseLeftButtonDown" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
