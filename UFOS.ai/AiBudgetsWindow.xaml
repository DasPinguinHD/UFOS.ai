<Window x:Class="UFOS.ai.AiBudgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI budgets" Width="900" Height="780" MinWidth="640" MinHeight="420"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        IsVisibleChanged="Window_IsVisibleChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="AI budgets">
    <!-- Central AI budget window (task B, contract UFOS.ai/docs/ai-budgets-spec.md §6): one card per
         registered module backend (Shared/AiBudgetProviders.cs), built in code-behind. Backend values
         are authoritative; cost-log totals are informational and always labelled "from the cost log".
         DesignSystem tokens only (Styles/DesignSystem.xaml). -->
    <Window.Resources>
        <!-- Visible keyboard focus on the dark background (the default dotted black rectangle is invisible). -->
        <Style x:Key="BudgetFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" StrokeThickness="1" Stroke="{StaticResource AccentBlueBrush}" StrokeDashArray="2 2"
                                   RadiusX="4" RadiusY="4" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Limit input (USD). -->
        <Style x:Key="BudgetInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HighEmphasisForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource HighEmphasisForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SmallCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action buttons (Refresh). -->
        <Style x:Key="BudgetButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundedDarkButtonTemplate}" />
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BudgetFocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- Text link ("Default: $1.00"). -->
        <Style x:Key="BudgetLinkStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BudgetFocusVisual}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="{StaticResource SubtleHoverOpacity}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Title bar (same chrome as MainWindow: black, drag, minimize/close) ===================== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" CornerRadius="8,8,0,0" Height="18"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="AI budgets" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource TertiaryForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentAmberBrush}" BorderBrush="Transparent"
                                AutomationProperties.Name="Minimize" IsTabStop="False">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentRedBrush}" BorderBrush="Transparent"
                                AutomationProperties.Name="Close" IsTabStop="False">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Row="1" Margin="20,16,8,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,12,12" LastChildFill="True">
                    <Button x:Name="RefreshAllButton" DockPanel.Dock="Right" VerticalAlignment="Top" Click="RefreshAllButton_Click"
                            Style="{StaticResource BudgetButtonStyle}" Margin="12,0,0,0"
                            ToolTip="Reload every module's budgets and the cost log (also refreshes every 30 s while this window is visible)"
                            AutomationProperties.Name="Refresh all modules">
                        <TextBlock Text="↻ Refresh all" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="AI budgets" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource QuietForegroundBrush}"
                                   Text="AI spending limits of every module, checked BEFORE each AI call (fail closed) by the module's backend — or by the app itself for &quot;UFOS.ai app&quot; (Summarize with AI). Limits and spend shown here come from that owner itself; periods are UTC days/months; 0 = off. A change is saved 0.6 s after you stop typing (or on Enter) — one budget at a time. Figures marked &quot;from the cost log&quot; are informational only." />
                        <TextBlock x:Name="WindowErrorText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                   Foreground="{StaticResource AccentRedBrush}" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </DockPanel>

                <!-- One card per registered module backend + the main-app row (code-behind). -->
                <ScrollViewer Grid.Row="1" x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,8,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="CardsPanel" KeyboardNavigation.TabNavigation="Continue" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
