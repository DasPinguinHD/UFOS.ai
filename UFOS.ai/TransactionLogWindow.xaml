<Window x:Class="UFOS.ai.TransactionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transaction Log" Width="1000" Height="720" MinWidth="680" MinHeight="420"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="RootBorder" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Title bar (same chrome as MainWindow: black, drag, minimize/close) ===================== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}" CornerRadius="8,8,0,0" Height="18"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Transaction Log" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource TertiaryForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentAmberBrush}" BorderBrush="Transparent"
                                AutomationProperties.Name="Minimize">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Template="{StaticResource PillButtonTemplate}"
                                Width="14" Height="14" Margin="6,0" Background="{StaticResource AccentRedBrush}" BorderBrush="Transparent"
                                AutomationProperties.Name="Close">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Transaction Log" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryForegroundBrush}" />
                    <TextBlock x:Name="SubtitleText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource QuietForegroundBrush}"
                               Text="Costs of every AI request across all modules (as charged by OpenRouter; 1 credit = 1 USD). Stored locally in %LOCALAPPDATA%\UFOS.ai\ai-cost-log.jsonl." />
                </StackPanel>

                <!-- Summary chips + actions -->
                <DockPanel Grid.Row="1" Margin="0,14,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Click="RefreshButton_Click" Template="{StaticResource RoundedDarkButtonTemplate}"
                                Padding="10,5" Margin="8,0,0,0" Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Reload the ledger file">
                            <TextBlock Text="↻ Refresh" FontSize="11.5" Foreground="{StaticResource PrimaryForegroundBrush}" />
                        </Button>
                        <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Template="{StaticResource RoundedDarkButtonTemplate}"
                                Padding="10,5" Margin="8,0,0,0" Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Open %LOCALAPPDATA%\UFOS.ai in Explorer">
                            <TextBlock Text="Open folder" FontSize="11.5" Foreground="{StaticResource PrimaryForegroundBrush}" />
                        </Button>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <WrapPanel.Resources>
                            <!-- Plain figures, no pill/ellipse outline (user request 2026-09-25). -->
                            <Style x:Key="ChipBorderStyle" TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0,5" />
                                <Setter Property="Margin" Value="0,0,24,4" />
                            </Style>
                            <Style x:Key="ChipLabelStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,7,0" />
                            </Style>
                            <Style x:Key="ChipValueStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </WrapPanel.Resources>

                        <Border Style="{StaticResource ChipBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All time" Style="{StaticResource ChipLabelStyle}" />
                                <TextBlock x:Name="TotalAllTimeText" Text="—" Style="{StaticResource ChipValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="This month" Style="{StaticResource ChipLabelStyle}" />
                                <TextBlock x:Name="TotalMonthText" Text="—" Style="{StaticResource ChipValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Today" Style="{StaticResource ChipLabelStyle}" />
                                <TextBlock x:Name="TotalTodayText" Text="—" Style="{StaticResource ChipValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Requests" Style="{StaticResource ChipLabelStyle}" />
                                <TextBlock x:Name="RequestCountText" Text="0" Style="{StaticResource ChipValueStyle}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </DockPanel>

                <!-- Entries, newest first -->
                <Border Grid.Row="2" Background="{StaticResource ModulePanelBackgroundBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource MediumCornerRadius}" Padding="4">
                    <Grid>
                        <ListBox x:Name="EntriesList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 HorizontalContentAlignment="Stretch"
                                 AutomationProperties.Name="AI requests, newest first">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="0,0,0,1" Padding="12,9" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource ModuleTileBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlBackgroundAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTipText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Vendor logo: the vendor's own favicon (loaded at runtime, see
                                             Services/VendorLogos.cs) on a neutral light circle; until then /
                                             without one, a grey circle with the vendor's initials. -->
                                        <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource ControlBackgroundBrush}" Stroke="{StaticResource ControlBorderBrush}" StrokeThickness="1"
                                                     Visibility="{Binding InitialsVisibility}" />
                                            <TextBlock Text="{Binding Initials}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding InitialsVisibility}" />
                                            <Ellipse Fill="#FFE4E4E4" Visibility="{Binding LogoVisibility}" />
                                            <Image Source="{Binding Logo}" Width="18" Height="18" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding LogoVisibility}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ModelName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                                            <TextBlock Text="{Binding VendorName}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ModuleFeature}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource SecondaryForegroundBrush}" />
                                            <TextBlock Text="{Binding TokensText}" FontSize="10.5" FontFamily="Consolas" Margin="0,2,0,0"
                                                       Foreground="{StaticResource MutedForegroundBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding LocalTimeText}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryForegroundBrush}" />

                                        <TextBlock Grid.Column="4" Text="{Binding CostText}" FontSize="13" FontFamily="Consolas"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource PrimaryForegroundBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyStateText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource QuietForegroundBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
