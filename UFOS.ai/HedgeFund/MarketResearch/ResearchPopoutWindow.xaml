<Window x:Class="UFOS.ai.HedgeFund.MarketResearch.ResearchPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Market Research" Height="900" Width="1440"
        MinHeight="680" MinWidth="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">
    <!-- Hedge Fund → Research → "⧉ Pop out" (Market Research MR1, docs/market-research-plan.md §2.1,
         backend/market_research/SPEC.md). Hosts the SAME ResearchView instance as the rail section
         (HedgeFundWindow moves it in and takes it back when this window closes) — no second backend
         client, no second set of timers. Chrome: local copy of the Hedge Fund window's black title bar
         and pill buttons (module design, no DesignSystem access); conventions "Borderless windows"
         (StateChanged padding + square corners while maximized, drag-to-restore). -->
    <!-- One Hedge Fund scroll bar design (Styles/ScrollBars.xaml): implicit for every ScrollBar in this window. -->
    <Window.Resources>
        <ResourceDictionary Source="/HedgeFundApp;component/Styles/ScrollBars.xaml" />
    </Window.Resources>
    <Border x:Name="RootBorder" Background="#FF111111" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.Resources>
                <Style x:Key="RoundButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="999" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: black 18 px, dot + "Market Research" (Consolas 10), minimize / maximize / close. -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="Black" CornerRadius="8,8,0,0" Height="18"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Ellipse Width="5" Height="5" Fill="#FF9A9A9A" VerticalAlignment="Center" />
                        <TextBlock Text="Market Research" FontFamily="Consolas" FontSize="10" Foreground="#FF9A9A9A" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="·  Hedge Fund · paper trading only · research data" FontFamily="Consolas" FontSize="10" Foreground="#FF5A5A5A"
                                   Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFEDB400"
                                ToolTip="Minimize" AutomationProperties.Name="Minimize">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FF4ADE80"
                                ToolTip="Maximize" AutomationProperties.Name="Maximize">
                            <TextBlock x:Name="MaximizeGlyph" Text="▢" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFED6A5A"
                                ToolTip="Close — Market Research returns to the Hedge Fund window" AutomationProperties.Name="Close the pop-out window">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The moved ResearchView (see Attach / ReleaseView). -->
            <!-- Inset so the hosted content never paints over the rounded bottom corners. -->
            <Border x:Name="ViewHost" Grid.Row="1" Margin="8,8,8,8" />
        </Grid>
    </Border>
</Window>
