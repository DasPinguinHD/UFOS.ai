<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<!-- Windows SDK TFM (2026-09-26): required by Microsoft.Toolkit.Uwp.Notifications (Windows toasts
	     for the paper-trading engine's events, Fund/FundNotifications.cs). The root UFOS.ai.csproj
	     references this project and therefore uses the same TFM. -->
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UseWPF>true</UseWPF>
	<RootNamespace>UFOS.ai.HedgeFund</RootNamespace>
	<AssemblyName>HedgeFundApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared AI-content labelling helper + startup AI notice (EU AI Act Art. 50).
         Linked, not referenced: the types are internal, each assembly gets its own copy.
         See ..\Shared\AiContent.cs. -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows toast notifications (flip / autopilot order / halt / margin call), Fund/FundNotifications.cs. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- WebView2 for the Market Research chart (stage MR3, MarketResearch/Chart; backend/market_research/SPEC.md).
         Same version as Global Monitoring/GlobalMonitoring.csproj and the root UFOS.ai.csproj. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- App-wide "Backend Log" window (AppLog), used by the Financial Newsroom backend launcher (Newsroom/NewsroomBackend.cs). -->
    <ProjectReference Include="..\UFOS.ai.Logging\UFOS.ai.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Market Research chart page (stage MR3a): chart.html/.js/.css + vendor/ are served from the output
         folder through the WebView2 virtual host mapping (MarketResearch/Chart/ChartHost.cs).
         Chart/tests/ is a development-only harness (Playwright, engine fetch script) and is not shipped. -->
    <None Update="MarketResearch\Chart\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="MarketResearch\Chart\tests\**\*" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
