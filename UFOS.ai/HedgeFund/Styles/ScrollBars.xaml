<!--
    Hedge Fund module — the ONE scroll bar design (user request 2026-10-19: "überall das Scrollbar design mit graustufen und schwarz
    … mit on click effekt (verkleinerung der bar)"). Grayscale on black: track #242424, thumb #4A4A4A, hover #6A6A6A, dragged #888888.
    Press effect: while the thumb is dragged it gets thinner (scale 0.55 across the bar, 100 ms) and returns when released (100 ms).
    Hit area: the bar stays 10 px wide (vertical) / high (horizontal) and the thumb's transparent root fills it, so a thin visual
    thumb is still easy to grab. Clicking the track pages (invisible RepeatButtons); the mouse wheel and the keyboard keep working
    through the ScrollViewer as before.

    Used by: every Hedge Fund window (merged in its resources — HedgeFundWindow, Keys & data, Research pop-out, Newsroom) and every
    code-built window / dialog through FundPopupWindow (FundUi.ApplyScrollBars). Implicit style below = every ScrollBar inside, incl.
    the internal bars of ListBox / DataGrid / TextBox / ComboBox drop-downs. Keys: CompactScrollBarStyle (keyed, both orientations),
    CompactScrollThumbStyle (vertical thumb), CompactHorizontalScrollThumbStyle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="HfScrollTrackBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="HfScrollThumbBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="HfScrollThumbHoverBrush" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="HfScrollThumbPressedBrush" Color="#FF888888" />

    <!-- Invisible, hit-testable page areas of the track (click = one page). -->
    <Style x:Key="HfScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical thumb: full-width transparent hit area, 6 px visual; thinner (ScaleX 0.55) while dragged. -->
    <Style x:Key="CompactScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource HfScrollThumbBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="bd" Margin="2,0,2,0" Background="{TemplateBinding Background}" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HfScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HfScrollThumbPressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.55" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal thumb: same, thinner across the bar (ScaleY 0.55) while dragged. -->
    <Style x:Key="CompactHorizontalScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource HfScrollThumbBrush}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="bd" Margin="0,2,0,2" Background="{TemplateBinding Background}" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HfScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HfScrollThumbPressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.55" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="HfVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Margin="2,0,2,0" Background="{StaticResource HfScrollTrackBrush}" CornerRadius="3" />
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource HfScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource CompactScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource HfScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HfHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Margin="0,2,0,2" Background="{StaticResource HfScrollTrackBrush}" CornerRadius="3" />
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource HfScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource CompactHorizontalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource HfScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Keyed: both orientations (the horizontal template is chosen by trigger). -->
    <Style x:Key="CompactScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource HfVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template" Value="{StaticResource HfHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit: every ScrollBar below the element that merges this dictionary. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyle}" />

</ResourceDictionary>
