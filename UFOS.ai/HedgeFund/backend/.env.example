# NOTE: part of UFOS.ai, a proof-of-concept portfolio project (not a published product).
# OpenRouter (https://openrouter.ai/keys) — powers the Financial Newsroom's
# "✦ Sum up most notable" insider-trades summary. Optional: without it the button
# reports that no key is configured; everything else works.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# Financial Newsroom "Analysis & Reasoning": model used ONLY by its "Premium" switch
# ("Standard" uses OPENROUTER_MODEL above). A premium model costs noticeably more per
# call. Must be an OpenRouter model id (check https://openrouter.ai/models).
# Default when unset: anthropic/claude-opus-5.5
# OPENROUTER_ANALYSIS_PREMIUM_MODEL=anthropic/claude-opus-5.5

WS_HOST=0.0.0.0
WS_PORT=8865
HEALTH_PORT=8867

MARKET_DATA_POLL_SECONDS=30

# ===== Financial Newsroom (moved from Global Monitoring, 2026-09-24) =====
# --- SEC EDGAR (insider trades) ---
# Required. SEC's Fair Access policy requires a descriptive User-Agent identifying
# the requester (name + contact email) — a generic/missing one gets throttled or
# blocked. This is not registered anywhere, you just write it yourself.
# This project is a personal portfolio / proof-of-concept build (not a published
# product), so say that plainly rather than implying commercial/production use:
# Example: "UFOS.ai HedgeFund (personal portfolio project / proof of concept, not published) you@example.com"
SEC_EDGAR_USER_AGENT=
SEC_EDGAR_POLL_SECONDS=120
SEC_EDGAR_MIN_REQUEST_INTERVAL_SECONDS=0.5

# --- FRED (macro indicators) ---
# Required for the Macro Indicators section. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
FRED_POLL_SECONDS=21600
# Economic Calendar section (FRED release dates + FOMC) — uses the same FRED_API_KEY
CALENDAR_POLL_SECONDS=21600
