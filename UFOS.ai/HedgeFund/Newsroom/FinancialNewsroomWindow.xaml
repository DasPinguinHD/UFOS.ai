<Window x:Class="UFOS.ai.HedgeFund.Newsroom.FinancialNewsroomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financial Newsroom" Height="720" Width="1080"
        MinHeight="480" MinWidth="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        StateChanged="Window_StateChanged">
    <!-- Financial Newsroom (Hedge Fund module). Sections come from
         NewsroomSections.All — add a section there, not here. -->
    <Border x:Name="RootBorder" Background="#111111" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.Resources>
                <!-- Window chrome: local copy of the Hedge Fund window's pill buttons. -->
                <Style x:Key="RoundButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="999" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Scrollbars: local copy of HedgeFundWindow's CompactScrollBarStyle (grayscale). -->
                <Style x:Key="CompactScrollThumbStyle" TargetType="Thumb">
                    <Setter Property="Background" Value="#FF4A4A4A" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF888888" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08" />
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CompactScrollBarStyle" TargetType="ScrollBar">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Border Margin="2,0,2,0" Background="#FF242424" CornerRadius="4"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource CompactScrollThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Horizontal variant (same look) for any horizontal scrollbar. -->
                <ControlTemplate x:Key="CompactHorizontalScrollBarTemplate" TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Border Margin="0,2,0,2" Background="#FF242424" CornerRadius="4"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsHitTestVisible="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CompactScrollThumbStyle}" MinHeight="0" MinWidth="28" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsHitTestVisible="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
                <!-- Implicit: every ScrollBar in this window, including those inside the hosted
                     section views, gets the Hedge Fund window's grayscale compact look. -->
                <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyle}">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="8" />
                            <Setter Property="Template" Value="{StaticResource CompactHorizontalScrollBarTemplate}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Navigation entry: glyph + title + subtitle, highlighted when selected. -->
                <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,8" BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF1C1C1C" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF222222" />
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#FF333333" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <DataTemplate x:Key="NavItemTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="12" Foreground="#FF9A9A9A" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFE6E6E6" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#FF7A7A7A" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: black, rounded, drag, minimize/close (Hedge Fund chrome). -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="Black" CornerRadius="8,8,0,0" Height="18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Ellipse x:Name="TitleStatusDot" Width="5" Height="5" Fill="#FF6A6A6A" VerticalAlignment="Center" />
                        <TextBlock Text="Financial Newsroom" Foreground="#FF9A9A9A" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleSectionText" Text="" Foreground="#FF5A5A5A" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Click="MinimizeButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFEDB400" ToolTip="Minimize">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFED6A5A" ToolTip="Close">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: section navigation (built from NewsroomSections.All) + backend status. -->
                <Border Grid.Column="0" Background="#FF151515" BorderBrush="#FF242424" BorderThickness="0,0,1,0" CornerRadius="0,0,0,8">
                    <Grid Margin="12,16,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="FINANCIAL NEWSROOM" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF6A6A6A"
                                   Margin="4,0,0,10" />
                        <ListBox Grid.Row="1" x:Name="SectionList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SectionList_SelectionChanged" />
                        <StackPanel Grid.Row="2" Margin="4,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BackendStatusDot" Width="6" Height="6" Fill="#FF6A6A6A" VerticalAlignment="Center" />
                                <TextBlock Text="Backend" FontSize="10" FontWeight="SemiBold" Foreground="#FF9A9A9A" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="BackendStatusText" Text="not started" FontSize="9.5" Foreground="#FF6A6A6A"
                                       Margin="12,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Proof of concept · live public data · not investment advice." FontSize="9" Foreground="#FF4A4A4A"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: the selected section's view (instances are kept while the window is open). -->
                <ContentControl Grid.Column="1" x:Name="SectionHost" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
