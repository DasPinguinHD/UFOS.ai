<UserControl x:Class="UFOS.ai.HedgeFund.Newsroom.InsiderTradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded" Unloaded="View_Unloaded">
    <!-- Financial Newsroom section "Insider Trades" (moved from Global Monitoring's
         InsiderTradesWindow on 2026-09-24). Gold = SEC filing data; violet = text
         written by a language model (AI content labelling, EU AI Act Art. 50). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="HighEmphasisForegroundBrush" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="#FFBFBFBF" />
        <SolidColorBrush x:Key="QuietForegroundBrush" Color="#FF8A8A8A" />
        <SolidColorBrush x:Key="InsiderGoldBrush" Color="#FFE8C468" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF2A2A2A" />
        <SolidColorBrush x:Key="AiAccentBrush" Color="#FFB98CE8" />
        <SolidColorBrush x:Key="AiSurfaceBrush" Color="#14B98CE8" />
        <!-- 2026-09-25: 10b5-1 chip, filter row and clusters banner (neutral / gold, never violet). -->
        <SolidColorBrush x:Key="ChipBorderBrush" Color="#FF4A4A4A" />
        <SolidColorBrush x:Key="ClusterSellBrush" Color="#FFC29B95" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <ControlTemplate x:Key="RefreshButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource InsiderGoldBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#22E8C468" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="AiButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource AiSurfaceBrush}" BorderBrush="{StaticResource AiAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#33B98CE8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <DataTemplate x:Key="InsiderTradeCardTemplate">
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource HighEmphasisForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding TimestampDisplay}" FontSize="10" Margin="8,2,0,0"
                                   Foreground="{StaticResource QuietForegroundBrush}" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TertiaryForegroundBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource InsiderGoldBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source}" FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource InsiderGoldBrush}" />
                        <TextBlock FontSize="10" Margin="12,0,0,0" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                            <Hyperlink NavigateUri="{Binding UrlUri}" RequestNavigate="Filing_RequestNavigate"
                                       Foreground="{StaticResource QuietForegroundBrush}">Open filing on SEC.gov ↗</Hyperlink>
                        </TextBlock>
                        <!-- Rule 10b5-1: trade scheduled in advance under a trading plan. -->
                        <Border Margin="12,0,0,0" Padding="6,0,6,1" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{StaticResource ChipBorderBrush}" VerticalAlignment="Center"
                                Visibility="{Binding IsPlan10b5One, Converter={StaticResource BoolToVis}}"
                                ToolTip="Pre-planned trade under a Rule 10b5-1 trading plan: scheduled months in advance, so it says little about the insider's current view.">
                            <TextBlock Text="10b5-1 plan" FontSize="9.5" Foreground="{StaticResource TertiaryForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Insider Trades" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HighEmphasisForegroundBrush}" />
                <TextBlock Text="Recent Form 4 filings from SEC EDGAR — proof-of-concept data, not investment advice."
                           FontSize="10.5" Margin="0,2,0,0" Foreground="{StaticResource QuietForegroundBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="LastUpdatedText" Text="" FontSize="9.5" Margin="0,3,0,0" FontFamily="Consolas"
                           Foreground="{StaticResource QuietForegroundBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SummaryButton" Content="✦ Sum up most notable" Click="SummaryButton_Click"
                        Template="{StaticResource AiButtonTemplate}" Foreground="{StaticResource AiAccentBrush}"
                        FontSize="11" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="↻ Refresh" Click="RefreshButton_Click"
                        Template="{StaticResource RefreshButtonTemplate}" Foreground="{StaticResource InsiderGoldBrush}"
                        FontSize="11" />
            </StackPanel>
        </Grid>

        <!-- AI summary card, hidden until first used: violet left accent, badge header,
             caveat footer (wording from Shared/AiContent.cs). -->
        <Border x:Name="SummaryCard" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"
                Background="{StaticResource AiSurfaceBrush}" BorderBrush="{StaticResource AiAccentBrush}"
                BorderThickness="3,0,0,0" CornerRadius="2" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="SummaryHeader" Text="✦ AI-GENERATED · MOST NOTABLE TRADES" FontSize="9.5" FontFamily="Consolas"
                           Foreground="{StaticResource AiAccentBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="SummaryText" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource HighEmphasisForegroundBrush}" />
                </ScrollViewer>
                <TextBlock x:Name="SummaryCaveat" Visibility="Collapsed" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{StaticResource QuietForegroundBrush}" Margin="0,8,0,0" />
                <!-- What OpenRouter charged for this request (usage.cost, credits = USD) + tokens. -->
                <TextBlock x:Name="SummaryCost" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource QuietForegroundBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Filter row: free text over title + summary, and "open-market purchases only". -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterTextBox" Grid.Column="0" TextChanged="FilterTextBox_TextChanged"
                     FontSize="11.5" Padding="6,4" VerticalContentAlignment="Center"
                     Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                     Foreground="{StaticResource HighEmphasisForegroundBrush}" CaretBrush="{StaticResource HighEmphasisForegroundBrush}"
                     AutomationProperties.Name="Filter by company, ticker or person" />
            <TextBlock x:Name="FilterHintText" Grid.Column="0" Text="Filter by company, ticker or person" IsHitTestVisible="False"
                       FontSize="11.5" Margin="9,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource QuietForegroundBrush}" />
            <CheckBox x:Name="PurchasesOnlyCheckBox" Grid.Column="1" Content="Open-market purchases only"
                      Checked="PurchasesOnlyCheckBox_Changed" Unchecked="PurchasesOnlyCheckBox_Changed"
                      Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11"
                      Foreground="{StaticResource TertiaryForegroundBrush}"
                      ToolTip="Only filings with at least one open-market purchase (transaction code P)" />
        </Grid>

        <!-- Insider clusters (backend: insider_summary.find_clusters) — hidden when there are none. -->
        <Border x:Name="ClustersBanner" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed"
                Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8">
            <ItemsControl x:Name="ClustersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" ToolTip="{Binding Tooltip}" FontSize="11.5" Margin="0,2" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ClusterSellBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBuy}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InsiderGoldBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ListScrollViewer">
                <ItemsControl x:Name="TradesList" ItemTemplate="{StaticResource InsiderTradeCardTemplate}" />
            </ScrollViewer>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Loading insider trades…" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource TertiaryForegroundBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
