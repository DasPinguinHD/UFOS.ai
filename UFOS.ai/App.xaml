<Application x:Class="UFOS.ai.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UFOS.ai"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Zentrale Design-Standards (Farben, Hover-Effekte, Eckenrundung) fuer UFOS.ai.
                     KI-Agenten und Entwickler: siehe Kommentar in Styles/DesignSystem.xaml -->
                <ResourceDictionary Source="Styles/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

