<Window x:Class="UFOS.ai.BackendLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backend Logs" Height="480" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0" Margin="0,0,0,8">
      <Button x:Name="RefreshBtn" Content="Refresh" Padding="8,4" Margin="0,0,8,0" Click="Refresh_Click" />
      <Button x:Name="SaveBtn" Content="Save" Padding="8,4" Margin="0,0,8,0" Click="Save_Click" />
      <Button x:Name="CloseBtn" Content="Close" Padding="8,4" Click="Close_Click" />
    </StackPanel>

    <Border Grid.Row="1" Background="#111" CornerRadius="6" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="LogsTextBox" IsReadOnly="True" TextWrapping="Wrap" Background="#111" Foreground="#EEE" BorderThickness="0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
