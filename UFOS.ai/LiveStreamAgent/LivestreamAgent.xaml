<Window x:Class="UFOS.ai.LivestreamAgent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UFOS.ai"
        mc:Ignorable="d"
        Title="FedAgent" Height="450" Width="800"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#111111" CornerRadius="8" Padding="0" SnapsToDevicePixels="True">
        <Grid>
            <Grid.Resources>
                <!-- Round button style for Apple-like controls -->
                <Style x:Key="RoundButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="999" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Rounded dark button style for main window actions -->
                <Style x:Key="RoundedDarkButtonStyle" TargetType="Button">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="Background" Value="#FF242424" />
                    <Setter Property="BorderBrush" Value="#FF333333" />
                    <Setter Property="Foreground" Value="#FFBFBFBF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Compact thumb style used by transcript scrollbar (copied into reusable resource) -->
                <Style x:Key="CompactScrollThumbStyle" TargetType="Thumb">
                    <Setter Property="Background" Value="#FF4A4A4A" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF888888" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08" />
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12" />
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsMouseCaptured" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF888888" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06" />
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.10" />
                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.10" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Compact scrollbar style to reuse in other windows -->
                <Style x:Key="CompactScrollBarStyle" TargetType="ScrollBar">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Border Margin="2,0,2,0" Background="#FF242424" CornerRadius="4"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource CompactScrollThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar (half size, black, rounded top corners) -->
            <Border Grid.Row="0" Background="Black" CornerRadius="8,8,0,0" Height="18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- Minimize: amber round button with minus symbol -->
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFEDB400" BorderBrush="Transparent">
                            <TextBlock Text="—" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Close: red round button with cross symbol -->
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource RoundButtonStyle}" Margin="6,0" Background="#FFED6A5A" BorderBrush="Transparent">
                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <!-- Confidence history under Connection status -->
                    <TextBlock Text="Confidence History" FontSize="12" FontStyle="Italic" Foreground="#FFBFBFBF" HorizontalAlignment="Left" Margin="479,72,0,0" VerticalAlignment="Top"/>
                    <Border HorizontalAlignment="Left" Margin="479,92,0,0" VerticalAlignment="Top" Background="#101010" CornerRadius="4" Padding="6" BorderBrush="#202020" BorderThickness="1" Width="300" Height="48">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="36">
                            <StackPanel x:Name="ConfidenceStack" Orientation="Horizontal" HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#141414" Margin="0">

                <!-- Market data rows: compact, wrapped layout (1-2 tickers per line) -->
                <ItemsControl x:Name="TickersItems" HorizontalAlignment="Left" Margin="25,226,0,0" VerticalAlignment="Top" Width="450" MaxHeight="250">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Use a two-column grid so each row contains 1 or 2 tickers and no items are clipped -->
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101010" CornerRadius="6" Padding="6" Margin="0,0,8,8" BorderBrush="#202020" BorderThickness="1" MinWidth="216" MinHeight="28" ToolTip="{Binding TooltipControl}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Grid.Column="0" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Grid.Column="0" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Change}" Foreground="#FFBFBFBF" FontSize="11" VerticalAlignment="Center" TextAlignment="Left" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Polygon Points="6,0 12,12 0,12" Fill="{Binding TrendColor}" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Polygon.RenderTransform>
                                                <RotateTransform Angle="{Binding TrendRotation}" />
                                            </Polygon.RenderTransform>
                                        </Polygon>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Right-side transcript: label above textbox with same vertical spacing (subheader look) -->
                <TextBlock x:Name="LiveTranscriptLabel" Text="Live Transcript" HorizontalAlignment="Left" Margin="479,186,0,0" VerticalAlignment="Top" FontSize="12" FontStyle="Italic" Foreground="#FFBFBFBF"/>
                <!-- Connection status under Session Data -->
                <Grid HorizontalAlignment="Left" Margin="479,40,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="Gray" Stroke="#222" StrokeThickness="1" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" Foreground="#FFBFBFBF" FontSize="12" Grid.Column="1" Grid.Row="0" Margin="8,0,0,0"/>
                    <Button x:Name="LogsButton" Content="Logs" Style="{StaticResource RoundedDarkButtonStyle}" MinWidth="52" Click="ShowLogs_Click" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Margin="85,3,-77,0"/>
                    <Button x:Name="RestartButton" Content="Restart" Style="{StaticResource RoundedDarkButtonStyle}" MinWidth="52" Click="RestartButton_Click" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Margin="145,3,-167,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ConnectionLastText" Text="last: -" Foreground="#FF8F8F8F" FontSize="11" Grid.Column="1" Grid.Row="1" Margin="8,0,0,0"/>
                </Grid>
                <Grid x:Name="TranscriptGrid" HorizontalAlignment="Left" Margin="479,226,0,0" VerticalAlignment="Top" Width="300" Height="200" MouseEnter="TranscriptGrid_MouseEnter" MouseLeave="TranscriptGrid_MouseLeave">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="23*"/>
                        <ColumnDefinition Width="278*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FF1B1B1B" CornerRadius="6" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="6" Grid.ColumnSpan="2">
                        <Border.Resources>
                            <Style x:Key="TranscriptThumbStyle" TargetType="Thumb">
                                <Setter Property="Background" Value="#FF4A4A4A" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF888888" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08" />
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12" />
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsMouseCaptured" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF888888" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06" />
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.10" />
                                                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.10" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="TranscriptScrollBarStyle" TargetType="ScrollBar">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Border Margin="2,0,2,0" Background="#FF242424" CornerRadius="4"/>
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource TranscriptThumbStyle}" />
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <TextBox x:Name="TranscriptTextBox" TextWrapping="Wrap" Text="Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: Newest text at the top Transcript is moving through live here: " VerticalAlignment="Stretch" Background="Transparent" Foreground="#FFF5F5F5" BorderThickness="0" CaretBrush="#FFF5F5F5" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextChanged="TextBox_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource TranscriptScrollBarStyle}" />
                                <Style TargetType="Thumb" BasedOn="{StaticResource TranscriptThumbStyle}" />
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                    <Rectangle x:Name="TranscriptFadeRect" IsHitTestVisible="False" VerticalAlignment="Top" Height="28" Opacity="1" Grid.ColumnSpan="2">
                        <Rectangle.Fill>
                            <!-- solid at top, fade downwards to transparent -->
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF141414" Offset="0" />
                                <GradientStop Color="#00141414" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Label Content="Session Data" HorizontalAlignment="Left" Margin="479,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" RenderTransformOrigin="0.868,0.515" Foreground="White"/>
                <Label Content="Market Data" HorizontalAlignment="Left" Margin="25,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" Foreground="White"/>

                <!-- Top Live Market Data label with dynamic timestamp (subheader look) -->
                <TextBlock x:Name="TopLiveMarketDataText" HorizontalAlignment="Left" Margin="22,186,0,0" VerticalAlignment="Top" FontSize="12" FontStyle="Italic" Foreground="#FFBFBFBF">
            <Run Text="Top Live Market Data: "/>
            <Run x:Name="TimestampRun" Text="" />
                </TextBlock>

                <Button x:Name="ExpandMarketButton" Content="Expand" Style="{StaticResource RoundedDarkButtonStyle}" MinWidth="52" Click="ExpandMarketButton_Click" HorizontalAlignment="Left" Margin="309,182,0,0" VerticalAlignment="Top" Height="24"/>
                <Popup x:Name="MarketDataPopup" PlacementTarget="{Binding ElementName=ExpandMarketButton}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="6" AllowsTransparency="True" StaysOpen="True">
                    <Border x:Name="MarketDataPopupBorder" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10" SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid x:Name="MarketDataPopupRoot" MouseEnter="MarketDataPopupRoot_MouseEnter" MouseLeave="MarketDataPopupRoot_MouseLeave">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="ExpandedMarketGrid" ClipToBounds="False"/>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Verdict widget under Market Data -->
                <Grid HorizontalAlignment="Left" Margin="22,50,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Circular ring + History button -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- ring container -->
                        <Grid>
                            <Ellipse x:Name="ConfidenceOuterEllipse" Width="80" Height="80" Stroke="#FFAAAAAA" StrokeThickness="10"/>
                            <!-- Foreground arc rendered as a Path so we draw an exact arc for the percent -->
                            <Path x:Name="RingArc" Width="80" Height="80" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="10" Fill="Transparent" Visibility="Visible">
                                <Path.Stroke>
                                    <LinearGradientBrush x:Name="ConfidenceRingBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFB30000" Offset="0.0" />
                                        <GradientStop Color="#FFFF2A2A" Offset="0.42" />
                                        <GradientStop Color="#FFFF9A9A" Offset="0.5" />
                                        <GradientStop Color="#FFFF2A2A" Offset="0.58" />
                                        <GradientStop Color="#FFB30000" Offset="1.0" />
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="ConfidenceRingBrushTransform" X="-1.2" />
                                        </LinearGradientBrush.RelativeTransform>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <!-- inner circle: dark background -->
                            <Ellipse Width="50" Height="50" Fill="#FF2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- confidence number centered inside inner circle -->
                            <TextBlock x:Name="ConfidenceCenterText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" />
                        </Grid>
                        <!-- Verdict navigation buttons placed under the ring; styled similar to Logs button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="PrevVerdictButton" Style="{StaticResource RoundedDarkButtonStyle}" MinWidth="23" Width="23" Height="22" Margin="0,0,4,0" Padding="0">
                                <Polygon Points="9,0 9,11 0,5.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="NextVerdictButton" Style="{StaticResource RoundedDarkButtonStyle}" MinWidth="23" Width="23" Height="22" Padding="0">
                                <Polygon Points="0,0 0,11 9,5.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- spacer -->

                    <!-- Verdict text and reason -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictTextBlock" Text="Current Verdict: " FontWeight="Bold" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="VerdictDateTextBlock" Text="" Visibility="Collapsed" FontSize="11" FontStyle="Italic" Foreground="#FFBFBFBF" Margin="0,2,0,0" />
                        <TextBlock x:Name="ReasonTextBlock" Text="" TextWrapping="Wrap" Foreground="#FFBFBFBF" Margin="0,6,16,0" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="LiveTranscript_subtitle" Text="Text may contain gaps: This is due to the algorithm compensating for slow API calls." HorizontalAlignment="Left" Margin="479,0,0,0" VerticalAlignment="Center" FontSize="8" FontStyle="Italic" Foreground="#FFBFBFBF"/>
                <TextBlock x:Name="TopLiveMarketDataDisclaimer1" Text="Latest Market Data will be displayed here: If markets are closed, data may be up to several days old." HorizontalAlignment="Left" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="8" FontStyle="Italic" Foreground="#FFBFBFBF"/>
                <TextBlock x:Name="TopLiveMarketDisclaimer2" Text="Nothing to see here yet. Give us a moment..." HorizontalAlignment="Left" Margin="117,321,0,0" VerticalAlignment="Top" FontSize="8" FontStyle="Italic" Foreground="#FFBFBFBF"/>

                <!-- Verdict history removed to avoid overlap; confidence history moved under Session Data -->

            </Grid>
        </Grid>
    </Border>
</Window>
