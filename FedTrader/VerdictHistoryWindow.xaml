<Window x:Class="FedTrader.VerdictHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FedTrader"
        Title="Verdict History" Height="480" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0" Margin="0,0,0,8">
      <Button x:Name="RefreshBtn" Content="Refresh" Padding="8,4" Margin="0,0,8,0" Click="Refresh_Click" />
      <Button x:Name="CloseBtn" Content="Close" Padding="8,4" Click="Close_Click" />
    </StackPanel>

    <Border Grid.Row="1" Background="#111" CornerRadius="6" Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- left: circular confidence badge (fallback, avoid custom control reference) -->
                  <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="64" Height="64" Stroke="{Binding StrokeBrush}" StrokeThickness="6" />
                    <Ellipse Width="40" Height="40" Fill="#FF2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                  </Grid>
                  <!-- right: header + reason -->
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding HeaderText}" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Foreground="#FFBFBFBF" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
